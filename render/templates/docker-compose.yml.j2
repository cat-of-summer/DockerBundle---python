{{ header }}
#
# Deploy:  docker compose --env-file .env up -d
# Update:  docker compose pull && docker compose up -d
#
# The bundle is one image holding every baked service. Anything that could not be baked
# is kept here as an ordinary neighbouring service.

{% if plan.module %}
# A module of a larger compose build: listed under its include: with project_directory: .,
# so data and hooks paths below resolve against that build. On its own, .env sets
# {{ plan.module.context_env }}=. and the same paths resolve here.
name: {{ plan.name }}${INSTANCE:-}

{% endif %}
services:
  {{ plan.name }}:
    image: ${BUNDLE_IMAGE:-{{ image_ref }}}
{% if plan.module and plan.module.context %}
    # Pulled first; built from the module only when the image cannot be pulled.
    build:
      context: ${{ "{" }}{{ plan.module.context_env }}:-{{ plan.module.context }}}
      args:
        HTTP_PROXY: ${HTTP_PROXY:-}
        HTTPS_PROXY: ${HTTPS_PROXY:-}
        NO_PROXY: ${NO_PROXY:-}
        http_proxy: ${HTTP_PROXY:-}
        https_proxy: ${HTTPS_PROXY:-}
        no_proxy: ${NO_PROXY:-}
{% endif %}
    container_name: {{ plan.name }}${INSTANCE:-}
{% if plan.module %}
    hostname: {{ plan.name }}${INSTANCE:-}
{% endif %}
    restart: unless-stopped
    # Programs drain on stop; the default 10s would kill them halfway.
    stop_grace_period: ${STOP_GRACE_PERIOD:-120s}
    env_file: .env
{% if plan.module %}
    logging:
      driver: json-file
      options:
        max-size: ${CONTAINER_LOGS_MAX_SIZE:-{{ plan.module.logs }}}
        max-file: "2"
{% endif %}
{% if shm_size %}
    # Asked for by one of the baked services. Docker's 64 MB default is where Chromium
    # runs out of shared memory part-way through a page.
    shm_size: {{ shm_size }}
{% endif %}
{% if published_ports %}
    ports:
{% for entry in published_ports %}
      - "{{ entry }}"
{% endfor %}
{% endif %}
{% if plan.named_volumes or plan.binds or (plan.module and plan.module.hooks) %}
    volumes:
{% for name, target in plan.named_volumes.items() %}
      - {{ name }}:{{ target }}
{% endfor %}
{% for bind in plan.binds %}
{% if bind.is_file %}
      # A missing file stops the start instead of turning into an empty directory.
      - type: bind
        source: {{ bind.source_expr }}
        target: {{ bind.target }}
{% if bind.read_only %}
        read_only: true
{% endif %}
        bind:
          create_host_path: false
{% else %}
      - {{ bind.source_expr }}:{{ bind.target }}{{ ':ro' if bind.read_only }}
{% endif %}
{% endfor %}
{% if plan.module and plan.module.hooks %}
      # Project logic: entrypoint.d/*.sh run at the end of start-up, supervisord.d/*.conf
      # add programs. Kept outside the module so an update does not overwrite it.
      - ./${{ "{" }}{{ plan.module.hooks_env }}:-{{ plan.module.hooks_host }}}:{{ plan.module.hooks }}:ro
{% endif %}
{% endif %}
    networks:
      - network
    healthcheck:
      test: ["CMD", "/usr/local/bin/bundle-healthcheck.sh"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: {{ start_period }}s
{% if cuda %}
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: ${GPU_COUNT:-1}
              capabilities: [gpu]
{% endif %}
{% if labels %}
    # Carried over from the services that were baked in. A label describes the whole
    # container, so where two of them disagreed the first was kept and the clash was
    # reported at generation time.
    labels:
{% for label in labels %}
      - "{{ label }}"
{% endfor %}
{% endif %}
{% for service in plan.sidecars %}

  # Not baked: {{ service.recipe_reason }}
  {{ service.spec.name }}:
{% if service.spec.image %}
    image: {{ service.spec.image }}
{% endif %}
    container_name: {{ service.spec.name }}${INSTANCE:-}
    restart: unless-stopped
    env_file: .env
{% if plan.module %}
    logging:
      driver: json-file
      options:
        max-size: ${CONTAINER_LOGS_MAX_SIZE:-{{ plan.module.logs }}}
        max-file: "2"
{% endif %}
{% if service.spec.command %}
    command:
{% for part in service.spec.command %}
      - "{{ part }}"
{% endfor %}
{% endif %}
{% if service.spec.ports %}
    ports:
{% for port in service.spec.ports %}
      - "{{ port.published }}:{{ port.container }}"
{% endfor %}
{% endif %}
{% if service.spec.mounts %}
    volumes:
{% for mount in service.spec.mounts %}
      - {{ mount.source }}:{{ mount.target }}{{ ':ro' if mount.read_only else '' }}
{% endfor %}
{% endif %}
    networks:
      - network
{% if sidecar_labels.get(service.spec.name) %}
    labels:
{% for label in sidecar_labels[service.spec.name] %}
      - "{{ label }}"
{% endfor %}
{% endif %}
{% endfor %}
{% if plan.named_volumes %}

volumes:
{% for name in plan.named_volumes %}
  {{ name }}:
{% endfor %}
{% endif %}

networks:
  network:
    external: {{ 'true' if plan.network_external else 'false' }}
    name: ${NETWORK:-{{ plan.network }}}
