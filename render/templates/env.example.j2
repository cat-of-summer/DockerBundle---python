{{ header }}
#
# Copy to .env and fill in. Values were merged from each source package's own
# .env.example; keys that collided were resolved as recorded in docker-bundle.yml.

# ---- bundle ------------------------------------------------------------------
BUNDLE_IMAGE={{ image_ref }}
INSTANCE={{ instance }}
{% if cuda %}
GPU_COUNT=1
{% endif %}
{% if plan.module %}

# ---- module ------------------------------------------------------------------
# This directory also works as a module of a larger compose build, pulled in as a git
# submodule and listed under its include: with project_directory: . - there the paths
# below resolve against that build, and its .env leaves {{ plan.module.context_env }} unset.
# Run on its own, the module is its own build context:
{{ plan.module.context_env }}=.
{% if plan.module.data %}
# What the deployment edits: every directory mounted from the host lives under it.
{{ plan.module.data_env }}={{ plan.module.data | replace('./', '', 1) }}
{% endif %}
{% if plan.module.hooks %}
# Project start-up logic: entrypoint.d/*.sh run at the end of start-up, supervisord.d/*.conf
# add programs.
{{ plan.module.hooks_env }}={{ plan.module.hooks_host }}
{% endif %}
# Container log rotation: size of one file (10m, 1g); the current and the previous are kept.
CONTAINER_LOGS_MAX_SIZE={{ plan.module.logs }}
{% if plan.module.context %}
# Proxy for building the image when it cannot be pulled. The address as the build sees it:
# host.docker.internal:10808, not 127.0.0.1.
# HTTP_PROXY=http://host.docker.internal:10808
# HTTPS_PROXY=http://host.docker.internal:10808
# NO_PROXY=localhost,127.0.0.1
{% endif %}
{% endif %}
{% set own_binds = plan.binds | rejectattr('root_env') | list %}
{% if own_binds %}

# ---- binds -------------------------------------------------------------------
# Kept on this machine and mounted into the container: edit them in place. Paths are
# relative to docker-compose.yml.
{% for bind in own_binds %}
# -> {{ bind.target }}
{{ bind.env }}={{ bind.host }}
{% endfor %}
{% endif %}
{% if replica_vars %}

# ---- replicas ----------------------------------------------------------------
# Only processes that do not bind a port can be scaled this way; the rest are fixed at
# one and dockerbundle warns if you try. Scale those with compose instead.
{% for name, count in replica_vars.items() %}
{{ name }}={{ count }}
{% endfor %}
{% endif %}
{% for section, entries in sections.items() %}

# ---- {{ section }} {{ '-' * (74 - section|length) }}
{% for entry in entries %}
{% if entry.comment %}
{% for line in entry.comment.split('\n') %}
# {{ line }}
{% endfor %}
{% endif %}
{{ entry.key }}={{ entry.value }}
{% endfor %}
{% endfor %}
