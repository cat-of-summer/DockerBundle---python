{{ header }}
#
# Copy to .env and fill in. Values were merged from each source package's own
# .env.example; keys that collided were resolved as recorded in bundle.yml.

# ---- bundle ------------------------------------------------------------------
BUNDLE_IMAGE={{ image_ref }}
INSTANCE=
{% if cuda %}
GPU_COUNT=1
{% endif %}
{% if replica_vars %}

# ---- replicas ----------------------------------------------------------------
# Only processes that do not bind a port can be scaled this way; the rest are fixed at
# one and dockerbundle warns if you try. Scale those with compose instead.
{% for name, count in replica_vars.items() %}
{{ name }}={{ count }}
{% endfor %}
{% endif %}
{% for section, entries in sections.items() %}

# ---- {{ section }} {{ '-' * (74 - section|length) }}
{% for entry in entries %}
{% if entry.comment %}
{% for line in entry.comment.split('\n') %}
# {{ line }}
{% endfor %}
{% endif %}
{{ entry.key }}={{ entry.value }}
{% endfor %}
{% endfor %}
