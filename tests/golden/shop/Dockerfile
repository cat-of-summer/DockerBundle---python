#
# Build:  docker build -t shop:latest .
# Run:    docker compose --env-file .env up -d
#
# This context is self-contained: everything COPY references lives under context/.

# Declared before the first FROM so that it is global. An ARG that follows a FROM belongs
# to that stage alone, and the base name of any later stage would then expand to nothing.
ARG BASE_IMAGE=debian:bookworm-slim

FROM ${BASE_IMAGE} AS bundle

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=${TZ:-UTC} \
    SUPERVISOR_CONF=/etc/supervisord.conf

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl procps tini supervisor netcat-openbsd \
        default-mysql-server \
        default-mysql-client \
        php-fpm \
        php-cli \
        php-mysql \
        php-pgsql \
        php-mbstring \
        php-xml \
        php-zip \
        php-intl \
        php-gd \
        php-bcmath \
        php-curl \
        php-sqlite3 \
        unzip \
        git \
        cron \
        nginx-light \
        gettext-base \
        openssl \
        nodejs \
        npm \
    && rm -rf /var/lib/apt/lists/*
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer
RUN rm -f /etc/php/*/fpm/pool.d/www.conf
RUN rm -f /etc/nginx/sites-enabled/default

# ---- mysql (mysql) --------------------------------------
COPY context/mysql/mysql.cnf /etc/mysql/conf.d/mysql.cnf

# ---- laravel_nginx_laravel (laravel) --------------------
COPY context/laravel_nginx_laravel/php.ini /etc/php/conf.d/laravel_nginx_laravel-custom.ini
COPY context/laravel_nginx_laravel/opcache.ini /etc/php/conf.d/laravel_nginx_laravel-opcache.ini
COPY context/laravel_nginx_laravel/crontab /etc/cron.d/laravel_nginx_laravel
RUN chmod 0644 /etc/cron.d/laravel_nginx_laravel
COPY context/laravel_nginx_laravel/data /var/www/laravel_nginx_laravel
COPY context/laravel_nginx_laravel/entrypoint.sh /usr/local/bin/entrypoint-laravel_nginx_laravel.sh
RUN chmod 0755 /usr/local/bin/entrypoint-laravel_nginx_laravel.sh
RUN sed -i -e 's#/var/www/html#/var/www/laravel_nginx_laravel#g' -e 's#^\([^#[:space:]][^[:space:]]*\([[:space:]]\+[^[:space:]]\+\)\{4\}\)[[:space:]]\+#\1 root #' /etc/cron.d/laravel_nginx_laravel || true

# ---- laravel_nginx_nginx (nginx) ------------------------
COPY context/laravel_nginx_nginx/nginx.conf /etc/nginx/templates/laravel_nginx_nginx.conf.template
COPY context/laravel_nginx_nginx/data /var/www/html
COPY context/laravel_nginx_nginx/entrypoint.sh /usr/local/bin/entrypoint-laravel_nginx_nginx.sh
RUN chmod 0755 /usr/local/bin/entrypoint-laravel_nginx_nginx.sh
RUN sed -i -E 's/^([[:space:]]*)listen[[:space:]]+80([^0-9]|$)/\1listen 80\2/' /etc/nginx/templates/laravel_nginx_nginx.conf.template || true

# ---- vue_nginx_vite_vue (node-frontend) -----------------
COPY context/vue_nginx_vite_vue/data /var/www/vue_nginx_vite_vue
COPY context/vue_nginx_vite_vue/entrypoint.sh /usr/local/bin/entrypoint-vue_nginx_vite_vue.sh
RUN chmod 0755 /usr/local/bin/entrypoint-vue_nginx_vite_vue.sh

# ---- vue_nginx_vite_nginx (nginx) -----------------------
COPY context/vue_nginx_vite_nginx/nginx.conf /etc/nginx/templates/vue_nginx_vite_nginx.conf.template
COPY context/vue_nginx_vite_nginx/data /var/www/html
COPY context/vue_nginx_vite_nginx/entrypoint.sh /usr/local/bin/entrypoint-vue_nginx_vite_nginx.sh
RUN chmod 0755 /usr/local/bin/entrypoint-vue_nginx_vite_nginx.sh
RUN sed -i -E 's/^([[:space:]]*)listen[[:space:]]+80([^0-9]|$)/\1listen 20000\2/' /etc/nginx/templates/vue_nginx_vite_nginx.conf.template || true

COPY context/_bundle/supervisord.conf /etc/supervisord.conf
COPY context/_bundle/entrypoint.sh /usr/local/bin/bundle-entrypoint.sh
COPY context/_bundle/healthcheck.sh /usr/local/bin/bundle-healthcheck.sh
RUN chmod +x /usr/local/bin/bundle-entrypoint.sh /usr/local/bin/bundle-healthcheck.sh \
    && mkdir -p /var/lib/bundle/init /var/log/supervisor /run/bundle

EXPOSE 80
EXPOSE 3306
EXPOSE 5173
EXPOSE 9000
EXPOSE 20000

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD /usr/local/bin/bundle-healthcheck.sh

# tini reaps the zombies that cron, composer and npm leave behind.
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/bundle-entrypoint.sh"]
