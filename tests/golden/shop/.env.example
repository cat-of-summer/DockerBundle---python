# Generated by dockerbundle 0.2.0. Do not edit; change docker-bundle.yml and regenerate.
#
# Copy to .env and fill in. Values were merged from each source package's own
# .env.example; keys that collided were resolved as recorded in docker-bundle.yml.

# ---- bundle ------------------------------------------------------------------
BUNDLE_IMAGE=ghcr.io/acme/shop-bundle:test
INSTANCE=

# ---- replicas ----------------------------------------------------------------
# Only processes that do not bind a port can be scaled this way; the rest are fixed at
# one and dockerbundle warns if you try. Scale those with compose instead.
LARAVEL_REPLICAS=1

# ---- global --------------------------------------------------------------------
NETWORK=network
TRAEFIK_DOMAIN=localhost
TRAEFIK_ENABLE=true

# ---- shared --------------------------------------------------------------------
# Environment
APP_URL=http://${TRAEFIK_DOMAIN}
DB_DATABASE=db
DB_HOST=mysql
DB_PASSWORD=password
# HTTP Basic Auth
HTTP_LOGIN=
# NODE_VERSION examples: lts-alpine
NODE_VERSION=lts-alpine
# PHP_VERSION examples: fpm-alpine, 8.2-fpm-alpine
PHP_VERSION=fpm-alpine
VITE_ACCESS=127.0.0.1:5173:5173

# ---- laravel_nginx_laravel -----------------------------------------------------
# External container access
LARAVEL_EXTERNAL_ACCESS=127.0.0.1:8081:80

# ---- laravel_nginx_nginx -------------------------------------------------------
# External container access
LARAVEL_NGINX_NGINX_EXTERNAL_ACCESS=127.0.0.1:8081:80

# ---- manual --------------------------------------------------------------------
VITE_API_BASE_URL=/api

# ---- mysql ---------------------------------------------------------------------
MYSQL_DATABASE=db
# External container access
MYSQL_EXTERNAL_ACCESS=127.0.0.1:3306:3306
MYSQL_PASSWORD=password
# Environment
MYSQL_USER=mysql
# MYSQL_VERSION examples: latest, 8.0
MYSQL_VERSION=8.0

# ---- traefik -------------------------------------------------------------------
TRAEFIK_API=false
TRAEFIK_EXTERNAL_ACCESS=127.0.0.1:8080:8080
TRAEFIK_VERSION=latest

# ---- vue_nginx_vite_nginx ------------------------------------------------------
# External container access
VUE_NGINX_VITE_NGINX_EXTERNAL_ACCESS=127.0.0.1:8082:80

# ---- vue_nginx_vite_vue --------------------------------------------------------
# External container access
VUE_EXTERNAL_ACCESS=127.0.0.1:8082:80
