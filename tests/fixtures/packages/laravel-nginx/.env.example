# PHP_VERSION examples: fpm-alpine, 8.2-fpm-alpine
PHP_VERSION=fpm-alpine

# Container settings
INSTANCE=
TRAEFIK_ENABLE=true
TRAEFIK_DOMAIN=localhost
NETWORK=network

# HTTP Basic Auth
HTTP_LOGIN=

# External container access
EXTERNAL_ACCESS=127.0.0.1:8081:80

# Environment
APP_URL=http://${TRAEFIK_DOMAIN}
DB_HOST=mysql
DB_DATABASE=db
DB_PASSWORD=password
